# 复制为 .env 并按需修改
DEBUG=false
DATABASE_URL=postgresql+asyncpg://novel:novel@localhost:5432/novel_agents
JWT_SECRET=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]

# providers.api_key 加密密钥（Fernet，base64 urlsafe 32 字节）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未设置时开发环境由 JWT_SECRET 派生（仅开发用）
FERNET_KEY=

# 供应商种子配置文件路径
MODELS_YAML=config/models.yaml

# KV 缓存 / 章节锁（D11）
# REDIS_URL 非空 → 启用 Redis；留空 → PG 回源（功能等价）
# KV_CACHE_ENABLED=false → 禁用缓存/锁（功能等价，无缓存）
REDIS_URL=
KV_CACHE_ENABLED=true
